// Cloudflare Workers static-assets deploy (Workers Builds runs `npx wrangler deploy`).
// SPA routing lives here, not in public/_redirects: /td, /jewel, /c/<token> all serve index.html.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "barebonesdgc",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
